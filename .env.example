# Required for live research. Get a key at https://aistudio.google.com/apikey
# Without it the app still runs, but only in clearly labelled offline-estimate mode.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional: Gemini model to use (default: gemini-3.7-flash)
# GEMINI_MODEL="gemini-3.7-flash"

# Optional: port for the server (default: 3000)
# PORT=3000
